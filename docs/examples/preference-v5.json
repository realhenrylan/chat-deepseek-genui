{
  "type": "genui",
  "version": 5,
  "title": "手机偏好对比",
  "state": [
    { "id": "budget", "label": "预算上限", "kind": "number", "initial": 6000, "min": 3000, "max": 9000, "step": 500, "unit": "元" },
    { "id": "priceWeight", "label": "价格权重", "kind": "number", "initial": 3, "min": 0, "max": 5, "step": 1 },
    { "id": "batteryWeight", "label": "续航权重", "kind": "number", "initial": 2, "min": 0, "max": 5, "step": 1 },
    { "id": "weightWeight", "label": "重量权重", "kind": "number", "initial": 1, "min": 0, "max": 5, "step": 1 }
  ],
  "derived": [],
  "models": [
    {
      "kind": "preference",
      "id": "pick",
      "label": "候选手机",
      "precision": 1,
      "dimensions": [
        { "id": "price", "label": "价格", "weight": { "op": "state", "id": "priceWeight" }, "direction": "lower" },
        { "id": "battery", "label": "续航", "weight": { "op": "state", "id": "batteryWeight" }, "direction": "higher" },
        { "id": "weight", "label": "重量控制", "weight": { "op": "state", "id": "weightWeight" }, "direction": "higher" }
      ],
      "candidates": [
        { "label": "手机 A", "values": { "price": 4999, "battery": 80, "weight": 190 } },
        { "label": "手机 B", "values": { "price": 5499, "battery": 88, "weight": 185 } },
        { "label": "手机 C", "values": { "price": null, "battery": 90, "weight": 180 } },
        { "label": "手机 D", "values": { "price": 4299, "battery": 72, "weight": 200 } },
        { "label": "手机 E", "values": { "price": 4599, "battery": 76, "weight": null } }
      ],
      "filters": [
        { "dimension": "price", "max": { "op": "state", "id": "budget" } }
      ]
    }
  ],
  "elements": [
    { "kind": "note", "text": "续航与重量为 0–100 的相对评分，价格单位为元；缺失资料不按 0 分计算。", "tone": "info" },
    { "kind": "slider", "bind": "budget" },
    { "kind": "note", "text": "调整三项权重会立即改变归一化得分与排名；权重为 0 的维度不参与计分，也不进入缺失分母。", "tone": "info" },
    {
      "kind": "columns",
      "columns": [
        [ { "kind": "slider", "bind": "priceWeight" } ],
        [ { "kind": "slider", "bind": "batteryWeight" } ],
        [ { "kind": "slider", "bind": "weightWeight" } ]
      ]
    },
    { "kind": "value", "label": "符合预算的候选", "source": { "kind": "model", "model": "pick", "key": "eligibleCount" }, "unit": "款" },
    { "kind": "value", "label": "最高得分", "source": { "kind": "model", "model": "pick", "key": "topScore" }, "unit": "分", "emphasis": "primary" },
    { "kind": "table", "title": "综合排名", "source": { "model": "pick", "view": "ranking" } },
    {
      "kind": "columns",
      "columns": [
        [ { "kind": "chart", "chartType": "bar", "title": "得分对比", "source": { "model": "pick" } } ],
        [ { "kind": "table", "title": "得分分解", "source": { "model": "pick", "view": "breakdown" } } ]
      ]
    },
    { "kind": "explain", "model": "pick", "title": "排名依据" }
  ]
}
