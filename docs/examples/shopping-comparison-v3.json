{
  "type": "genui",
  "version": 3,
  "title": "选购比较（交互）",
  "state": [
    {
      "id": "budget",
      "label": "预算",
      "kind": "number",
      "initial": 8000,
      "min": 1000,
      "max": 20000,
      "step": 100,
      "unit": "元"
    },
    {
      "id": "priceA",
      "label": "笔记本 A 单价",
      "kind": "number",
      "initial": 7000,
      "min": 1000,
      "max": 20000,
      "step": 100,
      "unit": "元"
    },
    {
      "id": "priceB",
      "label": "笔记本 B 单价",
      "kind": "number",
      "initial": 8600,
      "min": 1000,
      "max": 20000,
      "step": 100,
      "unit": "元"
    },
    {
      "id": "priceC",
      "label": "笔记本 C 单价",
      "kind": "number",
      "initial": 5300,
      "min": 1000,
      "max": 20000,
      "step": 100,
      "unit": "元"
    },
    {
      "id": "performanceA",
      "label": "A 性能分",
      "kind": "number",
      "initial": 82,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "performanceB",
      "label": "B 性能分",
      "kind": "number",
      "initial": 91,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "performanceC",
      "label": "C 性能分",
      "kind": "number",
      "initial": 74,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "priority",
      "label": "优先考虑",
      "kind": "select",
      "initial": "value",
      "options": [
        {
          "label": "综合分优先",
          "value": "value"
        },
        {
          "label": "价格优先",
          "value": "price"
        }
      ]
    }
  ],
  "derived": [
    {
      "id": "scoreA",
      "label": "A 综合分",
      "expression": {
        "op": "subtract",
        "left": {
          "op": "state",
          "id": "performanceA"
        },
        "right": {
          "op": "divide",
          "left": {
            "op": "state",
            "id": "priceA"
          },
          "right": {
            "op": "const",
            "value": 1000
          }
        }
      }
    },
    {
      "id": "scoreB",
      "label": "B 综合分",
      "expression": {
        "op": "subtract",
        "left": {
          "op": "state",
          "id": "performanceB"
        },
        "right": {
          "op": "divide",
          "left": {
            "op": "state",
            "id": "priceB"
          },
          "right": {
            "op": "const",
            "value": 1000
          }
        }
      }
    },
    {
      "id": "scoreC",
      "label": "C 综合分",
      "expression": {
        "op": "subtract",
        "left": {
          "op": "state",
          "id": "performanceC"
        },
        "right": {
          "op": "divide",
          "left": {
            "op": "state",
            "id": "priceC"
          },
          "right": {
            "op": "const",
            "value": 1000
          }
        }
      }
    }
  ],
  "elements": [
    {
      "kind": "section",
      "title": "筛选与偏好",
      "children": [
        {
          "kind": "columns",
          "columns": [
            [
              {
                "kind": "number-input",
                "bind": "budget"
              },
              {
                "kind": "select",
                "bind": "priority"
              }
            ],
            [
              {
                "kind": "text",
                "value": "综合分 = 性能分 − 单价/1000；分数越高越优先。"
              },
              {
                "kind": "note",
                "tone": "info",
                "text": "以下价格与性能为可调整的示例数据，不是实时报价。"
              },
              {
                "kind": "note",
                "tone": "info",
                "text": "当前按综合分排序：点击表格列头可改为按价格或预算余量查看。",
                "visibleIf": {
                  "op": "state-eq",
                  "id": "priority",
                  "value": "value"
                }
              },
              {
                "kind": "note",
                "tone": "info",
                "text": "当前按价格排序：预算余量从高到低，表示更省钱。",
                "visibleIf": {
                  "op": "state-eq",
                  "id": "priority",
                  "value": "price"
                }
              }
            ]
          ]
        }
